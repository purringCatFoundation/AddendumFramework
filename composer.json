{
    "name": "pcf/addendum-framework",
    "type": "library",
    "description": "PHP 8.5 micro-framework with attribute-based routing, JWT authentication, and CLI support",
    "license": "MIT",
    "authors": [
        {
            "name": "Pawel Radzikowski",
            "email": "paw.radzikowski@gmail.com"
        }
    ],
    "require-dev": {
        "php-ds/php-ds": "^1.8",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.2.17",
        "phpunit/phpunit": "^12.3",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "require": {
        "php": "^8.5",
        "ext-ds": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "psr/container": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "symfony/finder": "^7.0",
        "symfony/dotenv": "^7.0",
        "symfony/console": "^7.0",
        "symfony/process": "^7.0",
        "web-token/jwt-framework": "^3.3",
        "predis/predis": "^2.2",
        "dragonmantank/cron-expression": "^3.3",
        "monolog/monolog": "^3.0",
        "nette/php-generator": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "PCF\\Addendum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PCF\\Addendum\\Tests\\": "dev/tests/phpunit/"
        }
    },
    "bin": [
        "bin/addendum"
    ],
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "phpmd": "phpmd analyze --ruleset phpmd.xml --no-progress --strict src/",
        "quality": [
            "@phpcs",
            "@phpstan",
            "@phpmd"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
